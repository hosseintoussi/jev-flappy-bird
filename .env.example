# Get a key at https://console.typesafe.ai/keys
# This is only read by the local Node endpoint (server/jev.ts). It is never sent to the browser.
TYPESAFE_API_KEY=

# Optional. Defaults to jev-latest. Pin e.g. jev-1.13.0 for reproducible runs.
# TYPESAFE_DEFAULT_MODEL=jev-latest

# Optional. Per-request timeout in ms before a decision counts as an error. Default 2000.
# JEV_TIMEOUT_MS=2000
